# CleanBieber Environment Configuration

# Database (PostgreSQL via Neon / Supabase)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/cleanbieber?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/cleanbieber?sslmode=require"

# Application URL
APP_URL="http://localhost:3000"

# Authentication & Cron Security
AUTH_SECRET="change-this-to-a-very-secure-random-32-byte-hex-string"
CRON_SECRET="change-this-to-a-secure-cron-authorization-secret"

# Google Gemini Vision AI
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"

# Cloudinary Temporary Image Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Fonnte WhatsApp Gateway
FONNTE_TOKEN="your_fonnte_api_token"
ADMIN_WHATSAPP_NUMBER="081234567890"

# Initial Admin Bootstrap Credentials
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="admin_secure_initial_password"
